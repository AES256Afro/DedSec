{
  "name": "dednec",
  "version": "0.1.0",
  "private": true,
  "description": "A systemic social-engineering sandbox: ctOS-style profiling, hacking and human manipulation with no combat.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "serve": "npm run build && node scripts/serve.mjs",
    "sim": "npm run build && node dist/src/cli/headless.js",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "playtest": "node scripts/playtest.mjs",
    "smoke": "node scripts/smoke-street.mjs && node scripts/smoke-terminal.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.170.0",
    "playwright": "1.49.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
